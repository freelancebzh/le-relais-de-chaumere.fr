# Fichiers à ignorer

# Images (les WebP sont versionnés : ils sont servis par les balises <picture>)
*.jfif
*.jpeg

# Documents PDF (souvent personnels, ne jamais publier)
*.pdf

# Python
*.pyc
__pycache__/
*.py
!outils/*.py

# Fichiers temporaires
*.crdownload
.DS_Store
Thumbs.db

# Node
node_modules/
npm-debug.log

# Vscode
.vscode/
*.code-workspace

# Build/Dist
dist/
build/
*.min.js
*.min.css
